# Redirect DNS queries of the mesh VPN group to the local resolver on port 54.
#
# This replaces an iptables rule in the nat OUTPUT chain. fw4 only provides
# nat chains for prerouting (dstnat) and postrouting (srcnat), so the chain is
# added here; -100 is the priority iptables used for its nat OUTPUT chain.
chain gluon_mesh_vpn_dns {
	type nat hook output priority -100; policy accept;

	meta skgid "gluon-mesh-vpn" oifname "lo" ip daddr 127.0.0.1 udp dport 53 redirect to :54
}
